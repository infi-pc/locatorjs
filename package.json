{
  "name": "turborepo-basic-shared",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "test-apps/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=./packages/* --filter=./apps/*",
    "dev": "turbo run dev --parallel --filter=./packages/* --filter=./apps/*",
    "lint": "turbo run lint --filter=./packages/* --filter=./apps/*",
    "test": "turbo run test --filter=./packages/* --filter=./apps/*",
    "ts": "turbo run ts --filter=./packages/* --filter=./apps/*",
    "e2e": "turbo run e2e --filter=./apps/playwright",
    "typecheck": "pnpm ts",
    "check": "pnpm format:check && pnpm dependency-versions && turbo run lint ts test --filter=./packages/* --filter=./apps/* --ui=stream --log-order=grouped --output-logs=errors-only --continue=always",
    "check:fix": "pnpm format && pnpm dependency-versions:fix",
    "test-apps:dev": "turbo run dev --parallel --filter=./test-apps/*",
    "test-apps:build": "turbo run build --filter=./test-apps/*",
    "ui:lab": "pnpm --dir apps/ui-lab dev",
    "ui:lab:build": "pnpm --dir apps/ui-lab build",
    "format": "prettier --write \"{packages,apps}/**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"{packages,apps}/**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "publishPackages": "lerna publish",
    "clean": "concurrently pnpm:clean:*",
    "clean:node_modules": "rm -rf node_modules && rm -rf */*/node_modules",
    "clean:dist": "rm -rf */*/dist",
    "clean:turbo": "rm -rf */*/.turbo",
    "clean:next": "rm -rf */*/.next",
    "dependency-versions": "check-dependency-version-consistency . --ignore-path-pattern='^test-apps/' --ignore-dep=prettier",
    "dependency-versions:fix": "check-dependency-version-consistency . --fix --ignore-path-pattern='^test-apps/' --ignore-dep=prettier"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@pandacss/dev": "^1.11.4",
    "check-dependency-version-consistency": "5.0.1",
    "husky": "^9.1.7",
    "lerna": "^7.4.2",
    "lint-staged": "^16.4.0",
    "prettier": "^2.8.8",
    "turbo": "^2.9.6",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.7.5"
  },
  "packageManager": "pnpm@8.7.5"
}
