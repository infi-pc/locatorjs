{
  "name": "turborepo-basic-shared",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "test-apps/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=./packages/* --filter=./apps/*",
    "dev": "turbo run dev --parallel --filter=./packages/* --filter=./apps/*",
    "lint": "turbo run lint --filter=./packages/* --filter=./apps/*",
    "test": "turbo run test --filter=./packages/* --filter=./apps/*",
    "ts": "turbo run ts --filter=./packages/* --filter=./apps/*",
    "e2e": "turbo run e2e --filter=./apps/playwright",
    "test-apps:dev": "turbo run dev --parallel --filter=./test-apps/*",
    "test-apps:build": "turbo run build --filter=./test-apps/*",
    "format": "prettier --write \"{packages,apps}/**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"{packages,apps}/**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "publishPackages": "lerna publish",
    "clean": "concurrently pnpm:clean:*",
    "clean:node_modules": "rm -rf node_modules && rm -rf */*/node_modules",
    "clean:dist": "rm -rf */*/dist",
    "clean:turbo": "rm -rf */*/.turbo",
    "clean:next": "rm -rf */*/.next",
    "dependency-versions": "check-dependency-version-consistency . --ignore-path-pattern='^test-apps/'",
    "dependency-versions:fix": "check-dependency-version-consistency . --fix --ignore-path-pattern='^test-apps/'"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "check-dependency-version-consistency": "5.0.1",
    "husky": "^9.1.7",
    "lerna": "^7.3.0",
    "lint-staged": "^16.3.2",
    "prettier": "^2.8.8",
    "turbo": "^2.5.8",
    "vitest": "^2.1.4"
  },
  "engines": {
    "npm": ">=7.0.0",
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@8.7.5"
}
