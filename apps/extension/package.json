{
  "name": "locatorjs-extension",
  "version": "2.0.0",
  "description": "LocatorJS Chrome Extension - option-click to code (ReactJS)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/infi-pc/locatorjs-extension.git"
  },
  "scripts": {
    "build": "node utils/build.js",
    "test": "vitest run",
    "build:firefox": "TARGET_BROWSER=firefox node utils/build.js",
    "build:all": "run-s build build:firefox",
    "lint": "eslint src --ext .ts,.tsx",
    "dev": "node utils/webserver.js",
    "dev:firefox": "TARGET_BROWSER=firefox node utils/webserver.js",
    "start:firefox": "web-ext run --source-dir ./build/production_firefox",
    "pack:chrome": "cd ./build/production_chrome && zip -r ../chrome.zip .",
    "pack:firefox": "web-ext build --source-dir ./build/production_firefox --artifacts-dir ./build/artifacts_firefox",
    "pack:all": "run-s pack:chrome pack:firefox",
    "release:chrome": "node utils/release.js",
    "release:firefox": "node utils/release.js --firefox",
    "release": "node utils/release.js --all",
    "release:node": "node utils/release.js",
    "release:node:firefox": "node utils/release.js --firefox",
    "release:node:all": "node utils/release.js --all",
    "prettier": "prettier --write '**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "ts": "tsc --noEmit"
  },
  "dependencies": {
    "@locator/react-devtools-hook": "workspace:^",
    "@locator/runtime": "workspace:^",
    "@locator/shared": "workspace:^",
    "@locator/styled-system": "workspace:^",
    "@locator/ui": "workspace:^",
    "lucide-solid": "^1.14.0",
    "postcss": "^8.5.10",
    "postcss-loader": "^7.3.4",
    "postcss-preset-env": "^9.6.0",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@locator/babel-jsx": "workspace:^",
    "@locator/dev-config": "workspace:^",
    "@pandacss/dev": "^1.11.4",
    "@solidjs/testing-library": "^0.8.10",
    "@types/chrome": "^0.0.238",
    "babel-loader": "^9.2.1",
    "babel-preset-solid": "^1.9.12",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.11.0",
    "eslint": "^8.57.1",
    "file-loader": "^6.2.0",
    "fs-extra": "^11.3.4",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.6.7",
    "jsdom": "^20.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "source-map-loader": "^4.0.2",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.4.0",
    "typescript": "^5.9.3",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^2.1.9",
    "web-ext": "^7.12.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  }
}
