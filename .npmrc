# Refuse dependency versions published within the last day. Most npm
# supply-chain compromises are caught and unpublished within hours, so a short
# quarantine removes the bulk of the exposure at near-zero cost.
#
# NOTE: this setting requires pnpm >= 10.16. The repo currently pins
# pnpm@8.7.5 via packageManager, which parses the key but does not enforce it.
# It becomes active on the pnpm upgrade; until then it documents the intent.
minimum-release-age=1d
