{
  "name": "@locator/shared",
  "version": "2.0.0",
  "main": "./dist/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./strict-config": {
      "browser": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "import": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      },
      "require": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.cjs"
      },
      "default": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      }
    }
  },
  "license": "MIT",
  "scripts": {
    "dev": "concurrently pnpm:dev:*",
    "dev:ts": "tsc --watch --declaration --outDir dist --preserveWatchOutput",
    "dev:native": "node ../../scripts/build-native.js shared --watch",
    "build": "node ../../scripts/clean-package-dist.js && tsc -p tsconfig.build.json --declaration --outDir dist && node ../../scripts/build-native.js shared",
    "ts": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vitest watch",
    "lint": "eslint src --ext .ts,.tsx",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@locator/dev-config": "workspace:^",
    "fast-check": "4.9.0",
    "jsdom": "^20.0.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "gitHead": "64d49c931e745b61713e3349b9f872c115632c94",
  "files": [
    "dist",
    "src"
  ]
}
