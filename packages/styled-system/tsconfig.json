{
  "extends": "@locator/dev-config/tsconfig.base.json",
  // `dist` is Panda's generated output, not source, and is regenerated by
  // `panda codegen`. The theme and config files are what a change can break.
  "include": ["panda.config.ts", "preset.ts", "theme"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ESNext",
    "noEmit": true
  }
}
