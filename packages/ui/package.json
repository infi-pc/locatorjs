{
  "name": "@locator/ui",
  "version": "2.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "ICON-LICENSES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "concurrently pnpm:dev:*",
    "dev:babel": "babel src --watch --out-dir dist --extensions .ts,.tsx --copy-files",
    "dev:ts": "tsc --watch --declaration --emitDeclarationOnly --noEmit false --outDir dist --preserveWatchOutput",
    "build": "node ../../scripts/clean-package-dist.js && concurrently pnpm:build:babel pnpm:build:ts",
    "build:babel": "babel src --out-dir dist --extensions .ts,.tsx --copy-files --no-copy-ignored --ignore '**/*.test.ts,**/*.test.tsx'",
    "build:ts": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist",
    "ts": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.37.1",
    "@locator/shared": "workspace:^",
    "@locator/styled-system": "workspace:^",
    "lucide-solid": "^1.14.0",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@locator/dev-config": "workspace:^",
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@solidjs/testing-library": "^0.8.10",
    "babel-preset-solid": "^1.9.12",
    "concurrently": "^9.2.1",
    "jsdom": "^20.0.3",
    "typescript": "^5.9.3",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^2.1.9"
  }
}
