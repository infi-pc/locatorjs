{
  "ui": "tui",
  "concurrency": "20",
  "globalEnv": [
    "PORT",
    "PORT_WEB",
    "PORT_REACT",
    "PORT_UI_LAB",
    "PORT_SOLID",
    "PORT_PREACT",
    "PORT_SVELTE",
    "PORT_REACT_CLEAN",
    "PORT_SVELTE_CLEAN",
    "PORT_VUE",
    "PORT_NEXT_14",
    "PORT_NEXT_16",
    "PORT_NEXT_16_TURBO",
    "E2E_GROUP"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "cache": false
    },
    "e2e": {
      "cache": false
    },
    "ts": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
